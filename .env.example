API_URL=http://your-server:3000
API_TOKEN=
READ_INTERVAL=5
SEND_INTERVAL=30
HTTP_TIMEOUT=5
I2C_BUS=1
SHT31_ADDRESS=0x44
# Leave empty to discover exactly one DS18B20.
DS18B20_ID=
FRAMEBUFFER=/dev/fb1
TOUCH_DEVICE=/dev/input/event0
TOUCH_RAW_X=0,4095
TOUCH_RAW_Y=0,4095
TOUCH_ROTATION=0
HISTORY_PATH=/var/lib/pi-sensor-station/history.json
HISTORY_FLUSH_S=60
# Optional JSON file; built-in defaults match config.example.json.
MONITOR_CONFIG=
